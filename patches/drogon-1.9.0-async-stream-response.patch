+HttpResponsePtr HttpResponse::newAsyncStreamResponse(
+    const std::function<void(trantor::AsyncStreamPtr)> &callback,
+    ContentType type,
+    const std::string &typeString)
+{
+    if (!callback)
+    {
+        return HttpResponse::newNotFoundResponse();
+    }
+    auto resp = std::make_shared<HttpResponseImpl>();
+    resp->setAsyncStreamCallback(callback);
+    resp->setStatusCode(k200OK);
+    if (typeString.empty())
+    {
+        resp->setContentTypeCode(type);
+    }
+    else
+    {
+        if (type == CT_NONE)
+            type = parseContentType(typeString);
+        if (type == CT_NONE)
+            type = CT_CUSTOM;
+        static_cast<HttpResponse *>(resp.get())
+            ->setContentTypeCodeAndCustomString(type, typeString);
+    }
+    doResponseCreateAdvices(resp);
+    return resp;
+}
