 }
 
+class ChunkedAsyncStream final : public trantor::AsyncStream
+{
+  public:
+    explicit ChunkedAsyncStream(trantor::AsyncStreamPtr stream)
+        : stream_(std::move(stream))
+    {
+    }
+
+    bool send(const char *data, size_t len) override
+    {
+        if (!stream_ || data == nullptr || len == 0)
+            return false;
+        char header[32];
+        const auto headerLength =
+            static_cast<size_t>(snprintf(header, sizeof(header), "%zx\r\n", len));
+        std::string chunk;
+        chunk.reserve(headerLength + len + 2);
+        chunk.append(header, headerLength);
+        chunk.append(data, len);
+        chunk.append("\r\n", 2);
+        if (!stream_->send(std::move(chunk)))
+        {
+            stream_.reset();
+            return false;
+        }
+        return true;
+    }
+
+    void close() override
+    {
+        if (!stream_)
+            return;
+        stream_->send("0\r\n\r\n", 5);
+        stream_->close();
+        stream_.reset();
+    }
+
+    ~ChunkedAsyncStream() override
+    {
+        close();
+    }
+
+  private:
+    trantor::AsyncStreamPtr stream_;
+};
