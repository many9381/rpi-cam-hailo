+bool reserveAsyncStreamBytes(const std::shared_ptr<std::atomic<size_t>> &pending,
+                             size_t len) noexcept
+{
+    auto current = pending->load(std::memory_order_relaxed);
+    do
+    {
+        if (current > kAsyncStreamPendingByteLimit ||
+            len > kAsyncStreamPendingByteLimit - current)
+            return false;
+    } while (!pending->compare_exchange_weak(current,
+                                              current + len,
+                                              std::memory_order_relaxed,
+                                              std::memory_order_relaxed));
+    return true;
+}
+
+class AsyncStreamPendingReservation
+{
+  public:
+    AsyncStreamPendingReservation(
+        std::shared_ptr<std::atomic<size_t>> pending,
+        size_t len) noexcept
+        : pending_(std::move(pending)), len_(len)
+    {
+    }
+
+    ~AsyncStreamPendingReservation()
+    {
+        if (active_)
+            pending_->fetch_sub(len_, std::memory_order_relaxed);
+    }
+
+    void commit() noexcept
+    {
+        active_ = false;
+    }
+
+  private:
+    std::shared_ptr<std::atomic<size_t>> pending_;
+    size_t len_;
+    bool active_{true};
+};
+}  // namespace
