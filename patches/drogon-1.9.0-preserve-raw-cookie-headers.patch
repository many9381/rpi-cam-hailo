diff --git a/lib/src/HttpRequestParser.cc b/lib/src/HttpRequestParser.cc
index b9c6375..8b7d1ca 100644
--- a/lib/src/HttpRequestParser.cc
+++ b/lib/src/HttpRequestParser.cc
@@ -44,4 +44,10 @@ void HttpRequestParser::shutdownConnection(HttpStatusCode code)
-        connPtr->send(utils::formattedString(
-            "HTTP/1.1 %d %s\r\nConnection: close\r\n\r\n",
-            code,
-            statusCodeToString(code).data()));
+        auto response = HttpResponse::newHttpResponse();
+        response->setStatusCode(code);
+        response->setVersion(request_->getVersion());
+        response->setCloseConnection(true);
+        response->addHeader("Connection", "close");
+        HttpAppFrameworkImpl::instance().applyPreSendingAdvices(request_,
+                                                                response);
+        response->setPassThrough(true);
+        connPtr->send(
+            static_cast<HttpResponseImpl *>(response.get())->renderToBuffer());
