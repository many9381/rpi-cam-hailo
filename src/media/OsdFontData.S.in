/* Generated by CMake from OsdFontData.S.in: links the OSD font file into
   .rodata so the integrity manifest covers it with no extra file. */
    .section .rodata
    .balign 16
    .global camera_firmware_osd_font_start
    .global camera_firmware_osd_font_end
camera_firmware_osd_font_start:
